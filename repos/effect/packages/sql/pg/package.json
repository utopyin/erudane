{
  "name": "@effect/sql-pg",
  "version": "4.0.0-rc.111",
  "description": "A PostgreSQL toolkit for Effect",
  "keywords": [
    "database",
    "sql",
    "typescript"
  ],
  "homepage": "https://effect.website",
  "bugs": {
    "url": "https://github.com/Effect-TS/effect/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Effect-TS/effect.git",
    "directory": "packages/sql/pg"
  },
  "files": [
    "src/**/*.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "AGENTS.md",
    "CLAUDE.md",
    "ai-docs/**/*"
  ],
  "type": "module",
  "sideEffects": [],
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./*": "./src/*.ts",
    "./internal/*": null,
    "./index": null,
    "./*/index": null
  },
  "publishConfig": {
    "exports": {
      "./package.json": "./package.json",
      ".": "./dist/index.js",
      "./*": "./dist/*.js",
      "./internal/*": null,
      "./index": null,
      "./*/index": null
    },
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "benchmark:codec": "node benchmark/PgCodec.ts",
    "codegen": "effect-utils codegen",
    "build": "tsc -b tsconfig.json && pnpm babel",
    "babel": "babel dist --plugins annotate-pure-calls --out-dir dist --source-maps",
    "check": "tsc -b tsconfig.json"
  },
  "dependencies": {
    "pg": "^8.23.0",
    "pg-connection-string": "^2.14.0",
    "pg-cursor": "^2.22.0",
    "pg-pool": "^3.14.0",
    "pg-types": "^4.1.0"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.1.0",
    "@types/pg": "^8.21.0",
    "@types/pg-cursor": "^2.7.2",
    "effect": "workspace:^",
    "pg-protocol": "^1.16.0",
    "postgres": "^3.4.9",
    "tinybench": "^6.1.3"
  },
  "peerDependencies": {
    "effect": "workspace:^"
  },
  "tags": [
    "typescript",
    "sql",
    "database"
  ]
}

# Inference (production). Optional in dev when .auth/chatgpt.json exists (bun run login:chatgpt).
OPENAI_API_KEY=

# Cloudflare Hyperdrive config to adopt (by name) — `bunx wrangler hyperdrive get <id>`.
HYPERDRIVE_NAME=main-eu

# PlanetScale Postgres origin behind the Hyperdrive. The password is write-only on
# Cloudflare's side, so it must be supplied here; it is re-put on every deploy.
DB_HOST=eu-central-1.pg.psdb.cloud
DB_PORT=5432
DB_NAME=postgres
DB_USER=pscale_api_gq62g6daakjh.qir2334nbie2
DB_PASSWORD=

# Local Postgres started by `bun run dev` (Docker, postgres:18). Used only by the
# drizzle-kit CLI (db:generate / db:migrate / db:studio); the stack computes its own URL.
DATABASE_URL=postgres://erudane:erudane@localhost:54329/erudane

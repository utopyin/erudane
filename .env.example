# Development (`bun run dev`). Inference comes from .auth/chatgpt.json (bun run login:chatgpt);
# the database is the Docker Postgres the stack starts. Nothing here reaches a deploy.

# Local Postgres, used only by the drizzle-kit CLI (db:generate / db:migrate / db:studio).
DATABASE_URL=postgres://erudane:erudane@localhost:54329/erudane

# Optional: use an OpenAI key in dev instead of the ChatGPT subscription.
OPENAI_API_KEY=

# Firecrawl, for the research tools (WebSearch / FetchPage).
FIRECRAWL_API_KEY=

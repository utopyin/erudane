# Deployment (`bun run deploy` / `bun run destroy`, loaded with --env-file .env.production).

OPENAI_API_KEY=

# Optional Cloudflare Hyperdrive config to adopt, by name (`bunx wrangler hyperdrive get <id>`).
HYPERDRIVE_NAME=

# PlanetScale Postgres origin behind the Hyperdrive. The password is write-only on
# Cloudflare's side, so it must be supplied here; it is re-put on every deploy.
DB_HOST=eu-central-1.pg.psdb.cloud
DB_PORT=5432
DB_NAME=postgres
DB_USER=pscale_api_gq62g6daakjh.qir2334nbie2
DB_PASSWORD=

{
  "name": "erudane",
  "version": "0.0.0",
  "description": "Erudane is a learning platform that empowers you to learn anything.",
  "workspaces": {
    "packages": [
      "packages/*",
      "domains/*",
      "entrypoints/*",
      "apps/*",
      "scripts"
    ],
    "catalog": {
      "react": "^19.0.0",
      "react-dom": "^19.0.0",
      "effect": "4.0.0-rc.111",
      "@effect/platform-bun": "4.0.0-rc.111",
      "@effect/platform-node": "4.0.0-rc.111",
      "alchemy": "2.0.0-beta.74",
      "@effect/ai-openai": "4.0.0-rc.111",
      "@tanstack/ai": "^0.48.0",
      "@tanstack/ai-react": "^0.21.3"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "alchemy dev",
    "build": "turbo run build",
    "fix": "oxlint . --fix --disable-nested-config && oxfmt .",
    "check:types": "turbo run check:types",
    "check": "bun run fix && bun run check:types",
    "prepare": "effect-tsgo patch --typescript --oxlint",
    "deploy": "alchemy deploy",
    "destroy": "alchemy destroy",
    "login:chatgpt": "bun run scripts/chatgpt/login.ts"
  },
  "dependencies": {
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node": "catalog:",
    "alchemy": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/tsgo": "0.36.5",
    "oxfmt": "^0.64.0",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2001",
    "turbo": "^2.10.11",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.3.13"
}
